# backend 환경변수 템플릿 — 실제 값은 backend/.env 에 채우고, .env 는 커밋하지 않는다.
# 값 채우는 법은 scripts/dify_provision.sh 참고.

# ── LLM (로컬 전용, PRD §7.3) ──
OLLAMA_BASE_URL=http://localhost:11434
LLM_ROUTER_MODEL=gemma4:26b
LLM_SYNTHESIS_MODEL=gemma4:26b
# 합성 컨텍스트 창(토큰). 크게 할수록 여러 시트 데이터 수용 ↑, 메모리·지연 ↑. 모델 최대 262144.
LLM_NUM_CTX=32768

# ── Dify (지식 계층) ──
DIFY_BASE_URL=http://localhost:8090
DIFY_DATASET_API_KEY=            # Dify 콘솔 → API keys 에서 발급
DIFY_DEFAULT_DATASET_ID=         # 기본(일반) 지식베이스 UUID — 선택 미해당/폴백 시 사용
# 지식 도메인별 dataset (L2 에이전틱 선택). 비우면 해당 도메인 미사용
DIFY_DATASET_GENERAL=            # 일반 지식 dataset UUID
DIFY_DATASET_STRATEGY=          # 전략 지식 dataset UUID

# ── Database ──
DATABASE_URL=sqlite:///./insight.db

# ── Tableau ──
TABLEAU_SERVER=                  # 예: https://YOUR-POD.online.tableau.com
TABLEAU_SITE=                    # 사이트 contentUrl
TABLEAU_PAT_NAME=                # Personal Access Token 이름
TABLEAU_PAT_SECRET=              # Personal Access Token 시크릿
TABLEAU_DATASOURCE_LUID=
TABLEAU_DATASOURCE_MAP=
TABLEAU_GATEWAY_MODE=vds
USE_MCP=false

# ── Tableau Connected App (Direct Trust) — 무로그인 임베딩 ──
TABLEAU_CA_CLIENT_ID=
TABLEAU_CA_SECRET_ID=
TABLEAU_CA_SECRET_VALUE=
# JWT sub (사이트 사용자 이메일). 비우면 PAT 사용자 자동 감지
TABLEAU_USER=
